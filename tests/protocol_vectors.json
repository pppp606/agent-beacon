{
  "comment": "Shared protocol test vectors (docs/protocol.md). Consumed by both the firmware decode test (via tests/firmware_harness.cpp) and the CLI encode test, so the two sides cannot drift apart.",
  "decode": [
    { "state": 0, "red": false, "green": false, "blue": false, "blink": false, "note": "off" },
    { "state": 1, "red": true, "green": false, "blue": false, "blink": false, "note": "red solid" },
    { "state": 2, "red": false, "green": true, "blue": false, "blink": false, "note": "green solid" },
    { "state": 3, "red": true, "green": true, "blue": false, "blink": false, "note": "yellow solid" },
    { "state": 4, "red": false, "green": false, "blue": true, "blink": false, "note": "blue solid" },
    { "state": 5, "red": true, "green": false, "blue": true, "blink": false, "note": "magenta solid" },
    { "state": 6, "red": false, "green": true, "blue": true, "blink": false, "note": "cyan solid" },
    { "state": 7, "red": true, "green": true, "blue": true, "blink": false, "note": "white solid" },
    { "state": 9, "red": true, "green": false, "blue": false, "blink": true, "note": "red blink" },
    { "state": 11, "red": true, "green": true, "blue": false, "blink": true, "note": "yellow blink" },
    { "state": 15, "red": true, "green": true, "blue": true, "blink": true, "note": "white blink" },
    { "state": 8, "red": true, "green": false, "blue": false, "blink": true, "note": "fail-safe: blink bit only -> red blink" },
    { "state": 16, "red": true, "green": false, "blue": false, "blink": false, "note": "fail-safe: reserved bit -> red solid" },
    { "state": 24, "red": true, "green": false, "blue": false, "blink": true, "note": "fail-safe: reserved + blink -> red blink" },
    { "state": 128, "red": true, "green": false, "blue": false, "blink": false, "note": "fail-safe: reserved bit -> red solid" },
    { "state": 255, "red": true, "green": true, "blue": true, "blink": true, "note": "all bits -> white blink" }
  ],
  "encode": [
    { "color": "red", "blink": false, "state": 1 },
    { "color": "green", "blink": false, "state": 2 },
    { "color": "blue", "blink": false, "state": 4 },
    { "color": "yellow", "blink": false, "state": 3 },
    { "color": "magenta", "blink": false, "state": 5 },
    { "color": "cyan", "blink": false, "state": 6 },
    { "color": "white", "blink": false, "state": 7 },
    { "color": "red", "blink": true, "state": 9 },
    { "color": "yellow", "blink": true, "state": 11 },
    { "color": "white", "blink": true, "state": 15 }
  ],
  "display": [
    { "state": 0, "phase": 0, "red": false, "green": false, "blue": false, "blink": false, "note": "off stays off in every phase" },
    { "state": 0, "phase": 3, "red": false, "green": false, "blue": false, "blink": false, "note": "off stays off in every phase" },
    { "state": 1, "phase": 0, "red": true, "green": false, "blue": false, "blink": false, "note": "single color is steady" },
    { "state": 1, "phase": 5, "red": true, "green": false, "blue": false, "blink": false, "note": "single color is steady" },
    { "state": 3, "phase": 0, "red": true, "green": false, "blue": false, "blink": false, "note": "red+green cycles: phase 0 red" },
    { "state": 3, "phase": 1, "red": false, "green": true, "blue": false, "blink": false, "note": "red+green cycles: phase 1 green" },
    { "state": 3, "phase": 2, "red": true, "green": false, "blue": false, "blink": false, "note": "red+green cycles: wraps to red" },
    { "state": 5, "phase": 0, "red": true, "green": false, "blue": false, "blink": false, "note": "red+blue cycles in bit order" },
    { "state": 5, "phase": 1, "red": false, "green": false, "blue": true, "blink": false, "note": "red+blue cycles in bit order" },
    { "state": 6, "phase": 0, "red": false, "green": true, "blue": false, "blink": false, "note": "green+blue: phase 0 green" },
    { "state": 6, "phase": 1, "red": false, "green": false, "blue": true, "blink": false, "note": "green+blue: phase 1 blue" },
    { "state": 7, "phase": 0, "red": true, "green": false, "blue": false, "blink": false, "note": "all three: red" },
    { "state": 7, "phase": 1, "red": false, "green": true, "blue": false, "blink": false, "note": "all three: green" },
    { "state": 7, "phase": 2, "red": false, "green": false, "blue": true, "blink": false, "note": "all three: blue" },
    { "state": 7, "phase": 3, "red": true, "green": false, "blue": false, "blink": false, "note": "all three: wraps to red" },
    { "state": 11, "phase": 0, "red": true, "green": false, "blue": false, "blink": true, "note": "blink applies to the whole cycle" },
    { "state": 11, "phase": 1, "red": false, "green": true, "blue": false, "blink": true, "note": "blink applies to the whole cycle" },
    { "state": 8, "phase": 0, "red": true, "green": false, "blue": false, "blink": true, "note": "fail-safe: blink bit only -> red blink" },
    { "state": 8, "phase": 1, "red": true, "green": false, "blue": false, "blink": true, "note": "fail-safe red is steady across phases" },
    { "state": 16, "phase": 2, "red": true, "green": false, "blue": false, "blink": false, "note": "fail-safe: reserved bit -> red solid" }
  ],
  "display_timeout": [
    { "state": 0, "elapsed_red": 0, "elapsed_green": 0, "elapsed_blue": 0, "elapsed_failsafe": 0, "timeout": 600000, "effective": 0, "note": "off stays off" },
    { "state": 1, "elapsed_red": 599999, "elapsed_green": 0, "elapsed_blue": 0, "elapsed_failsafe": 0, "timeout": 600000, "effective": 1, "note": "just under the timeout: still shown" },
    { "state": 1, "elapsed_red": 600000, "elapsed_green": 0, "elapsed_blue": 0, "elapsed_failsafe": 0, "timeout": 600000, "effective": 0, "note": "single stale bit goes fully dark, no fail-safe" },
    { "state": 3, "elapsed_red": 660000, "elapsed_green": 60000, "elapsed_blue": 0, "elapsed_failsafe": 0, "timeout": 600000, "effective": 2, "note": "bits expire independently: red stale, green fresh" },
    { "state": 7, "elapsed_red": 660000, "elapsed_green": 660000, "elapsed_blue": 660000, "elapsed_failsafe": 0, "timeout": 600000, "effective": 0, "note": "all stale -> dark" },
    { "state": 11, "elapsed_red": 60000, "elapsed_green": 660000, "elapsed_blue": 0, "elapsed_failsafe": 0, "timeout": 600000, "effective": 9, "note": "blink rides along with the surviving bit" },
    { "state": 11, "elapsed_red": 660000, "elapsed_green": 660000, "elapsed_blue": 0, "elapsed_failsafe": 0, "timeout": 600000, "effective": 0, "note": "blink does not outlive the color bits" },
    { "state": 8, "elapsed_red": 0, "elapsed_green": 0, "elapsed_blue": 0, "elapsed_failsafe": 60000, "timeout": 600000, "effective": 8, "note": "fail-safe value on its own clock: fresh" },
    { "state": 8, "elapsed_red": 0, "elapsed_green": 0, "elapsed_blue": 0, "elapsed_failsafe": 600000, "timeout": 600000, "effective": 0, "note": "fail-safe value times out too" },
    { "state": 16, "elapsed_red": 0, "elapsed_green": 0, "elapsed_blue": 0, "elapsed_failsafe": 660000, "timeout": 600000, "effective": 0, "note": "reserved-bit value times out via the failsafe clock" },
    { "state": 5, "elapsed_red": 60000, "elapsed_green": 0, "elapsed_blue": 660000, "elapsed_failsafe": 0, "timeout": 600000, "effective": 1, "note": "red survives, blue stale" }
  ],
  "rmw": [
    { "op": "set", "current": 0, "bit": 1, "blink": false, "result": 1, "note": "first host in" },
    { "op": "set", "current": 1, "bit": 2, "blink": false, "result": 3, "note": "second host joins, first is kept" },
    { "op": "set", "current": 3, "bit": 1, "blink": false, "result": 3, "note": "idempotent" },
    { "op": "set", "current": 2, "bit": 1, "blink": true, "result": 11, "note": "blink bit is shared" },
    { "op": "set", "current": 0, "bit": 4, "blink": false, "result": 4, "note": "blue host" },
    { "op": "clear", "current": 3, "bit": 1, "result": 2, "note": "own bit only; other host keeps waiting" },
    { "op": "clear", "current": 2, "bit": 2, "result": 0, "note": "last host out turns everything off" },
    { "op": "clear", "current": 11, "bit": 1, "result": 10, "note": "blink survives while another host waits" },
    { "op": "clear", "current": 10, "bit": 2, "result": 0, "note": "last host out drops the blink bit too" },
    { "op": "clear", "current": 0, "bit": 1, "result": 0, "note": "idempotent" },
    { "op": "clear", "current": 17, "bit": 1, "result": 0, "note": "no color left -> full clear incl. reserved bits (avoid fail-safe red)" },
    { "op": "clear", "current": 19, "bit": 1, "result": 18, "note": "reserved bits are preserved while a color remains" }
  ]
}
