{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /PATH/TO/agent-beacon/integrations/claude-code/attention_hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /PATH/TO/agent-beacon/integrations/claude-code/attention_hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /PATH/TO/agent-beacon/integrations/claude-code/attention_hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /PATH/TO/agent-beacon/integrations/claude-code/attention_hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /PATH/TO/agent-beacon/integrations/claude-code/attention_hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "idle_prompt|permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /PATH/TO/agent-beacon/integrations/claude-code/attention_hook.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
